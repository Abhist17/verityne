# --- python ----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- node / next -----------------------------------------------------------
node_modules/
.next/
out/
*.tsbuildinfo

# --- secrets ---------------------------------------------------------------
.env
.env.local

# --- runtime state (regenerated; never source of truth) ---------------------
storage/uploads/*
storage/heatmaps/*
storage/models/
storage/*.db

# --- generated corpus (rebuild with `make dataset`) ------------------------
datasets/corpus/
datasets/redteam/
datasets/manifest.json

# --- downloaded research datasets (rebuild with `make data-real`) ----------
# LFW, MIDV-2020 and Celeb-DF are fetched from their sources, not vendored.
# Celeb-DF in particular is covered by a licence agreement that is granted to a
# named requester, so redistributing it through this repo is not ours to do.
# Detector 6's corpora. The Aalto archive alone is 1.5 GB, and every file here is
# third-party data fetched by `make behavioral-data` rather than anything of ours
# — the same treatment LFW and MIDV-2020 get.
datasets/keystrokes/
datasets/lfw/
datasets/midv2020/
datasets/celebdf/
datasets/faceforensics/
datasets/dfdc/
# Real photographs of Indian people, fetched on demand by `make indian-faces`.
# Third-party dataset shards plus the FFHQ faces they are scored against:
# fetched from source, never vendored.
datasets/indian_faces/

# Real human keystroke timings (Aalto 136M + CMU), for Detector 6. The source
# archive alone is 1.5 GB and the derived JSONL another 50 MB; both are rebuilt
# by `backend/scripts/keystroke_corpus.py` from their published sources.
datasets/keystrokes/

# Derived from MIDV-2020, so it inherits that dataset's terms and is rebuilt
# with `make real-docs` rather than committed.
datasets/real_docs/

# Transpiled scratch copy of frontend/lib/telemetry.ts, used to score the real
# collector against the keystroke corpus. A build artefact, not a source file.
storage/tmp_collector/

# --- personal documents, never committed ----------------------------------
# Your own ID used for a live demo lives here. It is your data, it stays on your
# machine, and nothing in the pipeline reads it for training.
storage/private/

# eval/*.json is committed on purpose: it is the evidence behind the README's
# numbers. Only the 1 MB raw per-detector score cache is excluded.
eval/scores.json

# --- misc ------------------------------------------------------------------
.DS_Store
*.log
