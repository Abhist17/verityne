# Copy to .env and adjust. Every value here has a working default.

# --- backend ---------------------------------------------------------------
VERITYNE_API_KEY=verityne-demo-key           # single-tenant demo auth
VERITYNE_DB=sqlite:///storage/verityne.db    # or postgresql+psycopg://user:pass@host/db
VERITYNE_STORAGE=./storage
VERITYNE_DEVICE=auto                         # auto | cuda | cpu
VERITYNE_MAX_UPLOAD_MB=40
VERITYNE_MAX_VIDEO_FRAMES=24
VERITYNE_FRAME_STRIDE=5                      # sampling stride within the clip
VERITYNE_WARMUP=1                            # load models at boot, not on first request
VERITYNE_CORS=http://localhost:3000
VERITYNE_LOG=INFO
HF_HOME=./storage/models/hf

# Optional: high-confidence rejections ping this Slack incoming webhook.
VERITYNE_SLACK_WEBHOOK=

# --- frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=verityne-demo-key
